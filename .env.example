# Скопируй в .env и заполни. .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=

# Telegram ID через запятую (@userinfobot): твой и девушки
ALLOWED_USERS=

# Локально — твой Postgres. На сервере не используется: адрес задаёт docker-compose.yml
DATABASE_URL=postgres://english:english@localhost:5432/english_bot

# Ключи ИИ
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Модели (можно не трогать)
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=openrouter/free

# Часовой пояс для «сегодня» и серии дней
# TIMEZONE=Asia/Shanghai

# Только для сервера: пароль базы в Docker (латиница и цифры, без спецсимволов)
POSTGRES_PASSWORD=
